{
  "name": "live-classroom",
  "version": "0.2.0",
  "description": "A content pipeline that turns a hand-written lesson plan into one narrated cartoon lesson, rendered scene by scene with MiniMax H3 Max and joined into a single video.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "render": "node --import tsx --env-file-if-exists=.env.local src/cli/render-lesson.ts",
    "prompts": "node scripts/expanded-prompts.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "verify": "node scripts/verify-no-spend.mjs"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.4.0",
    "eslint": "^9.39.5",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.47.0"
  }
}
